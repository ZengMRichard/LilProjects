# Facet reads its configuration from the environment. Every value below is optional in development.

# dev | prod. prod requires FACET_SECRET and FACET_STORAGE_KEY and turns off the dev shortcuts
# (instant sign-in, test checkout, API docs).
FACET_ENV=dev

# Where the SQLite database, encrypted photos and local keys live.
# FACET_DATA_DIR=.data
# FACET_DB_URL=sqlite:///.data/facet.db

# 32-byte hex keys. Generated into .data/keys/ on first run when unset (development only).
# FACET_SECRET=
# FACET_STORAGE_KEY=

# The web app's origin: used for cross-site checks and for the PDF renderer's URL.
# FACET_WEB_URL=http://localhost:3000
# FACET_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the web app proxies /v1 to. Read when the web app starts in development, and baked in by
# `pnpm build` for the built app, so set it before building.
# FACET_API_URL=http://127.0.0.1:8787

# Days between full scans. Defaults to 14 in prod and 0 (off) in dev.
# FACET_SCAN_MIN_INTERVAL_DAYS=14
# Days a photo is kept after its report is delivered.
# FACET_IMAGE_RETENTION_DAYS=30

# PDF export: path or name of a Chrome/Chromium binary. Auto-detected when unset.
# FACET_CHROME_PATH=

# Optional LLM rewrite of the report summary. Needs `uv sync --extra llm` and Anthropic
# credentials (ANTHROPIC_API_KEY, or a profile from `ant auth login`).
# FACET_LLM_NARRATIVE=1
# FACET_LLM_MODEL=claude-opus-5-5
